{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\uc218\uc2e0\uc790 ID (AppUser ID \ub610\ub294 student_id)"
    },
    "user_role": {
      "type": "string",
      "enum": [
        "student",
        "parent",
        "admin",
        "super_admin"
      ],
      "description": "\uc218\uc2e0\uc790 \uc5ed\ud560"
    },
    "title": {
      "type": "string",
      "description": "\uc54c\ub9bc \uc81c\ubaa9"
    },
    "content": {
      "type": "string",
      "description": "\uc54c\ub9bc \ub0b4\uc6a9"
    },
    "notification_type": {
      "type": "string",
      "enum": [
        "notice",
        "unit_opened",
        "example_completed",
        "question_opened",
        "mission_opened",
        "feedback_added",
        "class_schedule",
        "algorithm_opened",
        "system"
      ],
      "default": "notice",
      "description": "\uc54c\ub9bc \uc720\ud615"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "\uc77d\uc74c \uc5ec\ubd80"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "\uc0ad\uc81c \uc5ec\ubd80"
    },
    "link_path": {
      "type": "string",
      "description": "\ud074\ub9ad \uc2dc \uc774\ub3d9 \uacbd\ub85c"
    }
  },
  "required": [
    "user_id",
    "title",
    "notification_type"
  ]
}
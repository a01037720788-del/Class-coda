{
  "name": "AppUser",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\uc0ac\uc6a9\uc790 \uc774\ub984"
    },
    "login_id": {
      "type": "string",
      "description": "\ub85c\uadf8\uc778 \uc544\uc774\ub514 (\uace0\uc720)"
    },
    "password": {
      "type": "string",
      "description": "\ube44\ubc00\ubc88\ud638 (PBKDF2 \ud574\uc2dc \uc800\uc7a5)"
    },
    "role": {
      "type": "string",
      "enum": [
        "super_admin",
        "admin",
        "teacher",
        "student",
        "parent"
      ],
      "default": "student",
      "description": "\uc5ed\ud560"
    },
    "phone": {
      "type": "string",
      "description": "\uc5f0\ub77d\ucc98"
    },
    "student_id": {
      "type": "string",
      "description": "\uc5f0\uacb0\ub41c Student ID (\ud559\uc0dd\uc778 \uacbd\uc6b0)"
    },
    "linked_student_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\uc5f0\uacb0\ub41c \ud559\uc0dd ID \ubaa9\ub85d (\ubd80\ubaa8\uc778 \uacbd\uc6b0)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\ud65c\uc131\ud654 \uc5ec\ubd80"
    },
    "must_change_password": {
      "type": "boolean",
      "default": false,
      "description": "\ucd5c\ucd08 \ub85c\uadf8\uc778 \uc2dc \ube44\ubc00\ubc88\ud638 \ubcc0\uacbd \uac15\uc81c \uc5ec\ubd80"
    }
  },
  "required": [
    "name",
    "login_id",
    "password",
    "role"
  ]
}
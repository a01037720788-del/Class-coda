{
  "name": "HTMLMissionSubmission",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "unit_id": {
      "type": "string"
    },
    "unit_title": {
      "type": "string"
    },
    "mission_number": {
      "type": "number"
    },
    "mission_title": {
      "type": "string"
    },
    "submitted_html": {
      "type": "string"
    },
    "submitted_css": {
      "type": "string",
      "default": ""
    },
    "submitted_javascript": {
      "type": "string",
      "default": ""
    },
    "condition_results": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "preview_html": {
      "type": "string",
      "default": ""
    },
    "is_completed": {
      "type": "boolean",
      "default": false
    },
    "submitted_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    }
  },
  "required": [
    "student_id",
    "unit_id",
    "mission_number"
  ]
}
      "default": "site",
      "description": "\uc77c\uc815 \ucd9c\ucc98 (site=\uc0ac\uc774\ud2b8\uc5d0\uc11c \uc0dd\uc131, google=Google Calendar\uc5d0\uc11c \uac00\uc838\uc634)"
    },
    "start_at": {
      "type": "string",
      "description": "\uc2dc\uc791 \uc77c\uc2dc (ISO 8601)"
    },
    "end_at": {
      "type": "string",
      "description": "\uc885\ub8cc \uc77c\uc2dc (ISO 8601)"
    },
    "is_all_day": {
      "type": "boolean",
      "default": false,
      "description": "\uc885\uc77c \uc77c\uc815 \uc5ec\ubd80"
    },
    "description": {
      "type": "string",
      "description": "\uc77c\uc815 \uc124\uba85 (Google Calendar)"
    },
    "location": {
      "type": "string",
      "description": "\uc7a5\uc18c (Google Calendar)"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\ucc38\uc11d\uc790 \uc774\uba54\uc77c \ubaa9\ub85d (Google Calendar)"
    },
    "recurrence_rule": {
      "type": "string",
      "description": "\ubc18\ubcf5 \uc77c\uc815 \uaddc\uce59 (RRULE, Google Calendar)"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "\uc77c\uc815 \uc0c1\ud0dc (scheduled=\uc608\uc815, cancelled=\ucde8\uc18c)"

    "google_status": {
      "type": "string",
      "description": "Google Calendar \uc77c\uc815 \uc0c1\ud0dc (confirmed/tentative/cancelled)"
    },
    "google_updated": {
      "type": "string",
      "description": "Google Calendar \ub9c8\uc9c0\ub9c9 \uc218\uc815 \uc2dc\uac01"
    },
    "google_color_id": {
      "type": "string",
      "description": "Google Calendar \uc77c\uc815 \uc0c9\uc0c1 ID"
    },
    "last_synced_at": {
      "type": "string",
      "description": "\ub9c8\uc9c0\ub9c9 \ub3d9\uae30\ud654 \uc2dc\uac01"
    }
  },
  "required": [

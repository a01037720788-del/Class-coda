{
  "name": "ClassSchedule",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "\uc218\uc5c5 \uc81c\ubaa9 (Google \uc6d0\ubcf8 \uc81c\ubaa9 \ubcf4\uc874)"
    },
    "google_original_title": {
      "type": "string",
      "description": "Google Calendar \uc6d0\ubcf8 \uc81c\ubaa9 (\ub3d9\uae30\ud654 \uc9c4\ub2e8\uc6a9 \ubcf4\uc874)"
    },
    "parsed_info": {
      "type": "object",
      "description": "Google \uc81c\ubaa9 \ud30c\uc2f1 \uacb0\uacfc (prefix, display_time, student_name, school, grade, week_or_level, subject_code)",
      "properties": {
        "prefix": {
          "type": "string"
        },
        "display_time": {
          "type": "string"
        },
        "student_name": {
          "type": "string"
        },
        "school": {
          "type": "string"
        },
        "grade": {
          "type": "string"
        },
        "week_or_level": {
          "type": "string"
        },
        "subject_code": {
          "type": "string"
        }
      }
    },
    "student_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\ud559\uc0dd ID \ubaa9\ub85d"
    },
    "student_names": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\ud559\uc0dd \uc774\ub984 \ubaa9\ub85d"
    },
    "student_link_source": {
      "type": "string",
      "enum": [
        "auto",
        "manual"
      ],
      "default": "auto",
      "description": "\ud559\uc0dd \uc5f0\uacb0 \ucd9c\ucc98 (auto=Google \uc790\ub3d9 \ub9e4\uce6d, manual=\uad00\ub9ac\uc790 \uc218\ub3d9 \uc5f0\uacb0)"
    },
    "subject_id": {
      "type": "string",
      "description": "\uacfc\ubaa9 ID"
    },
    "subject_name": {
      "type": "string",
      "description": "\uacfc\ubaa9\uba85"
    },
    "teacher_id": {
      "type": "string",
      "description": "\ub2f4\ub2f9 \uc120\uc0dd\ub2d8 ID"
    },
    "teacher_name": {
      "type": "string",
      "description": "\ub2f4\ub2f9 \uc120\uc0dd\ub2d8 \uc774\ub984"
    },
    "schedule_type": {
      "type": "string",
      "enum": [
        "single",
        "weekly"
      ],
      "default": "single",
      "description": "\uc77c\uc815 \uc720\ud615"
    },
    "class_date": {
      "type": "string",
      "format": "date",
      "description": "\uc218\uc5c5 \ub0a0\uc9dc"
    },
    "repeat_end_date": {
      "type": "string",
      "format": "date",
      "description": "\ubc18\ubcf5 \uc885\ub8cc\uc77c"
    },
    "recurrence_group_id": {
      "type": "string",
      "description": "\ubc18\ubcf5 \uc218\uc5c5 \uadf8\ub8f9 ID (\uac19\uc740 \ubc18\ubcf5 \uc218\uc5c5\ub07c\ub9ac \ub3d9\uc77c\ud55c \uac12)"
    },
    "duration_type": {
      "type": "string",
      "enum": [
        "1hour",
        "2hour"
      ],
      "default": "1hour",
      "description": "\uc218\uc5c5 \uc2dc\uac04"
    },
    "start_time": {
      "type": "string",
      "description": "\uc2dc\uc791 \uc2dc\uac04"
    },
    "end_time": {
      "type": "string",
      "description": "\uc885\ub8cc \uc2dc\uac04"
    },
    "lesson_number": {
      "type": "number",
      "description": "\ucc28\uc2dc"
    },
    "notes": {
      "type": "string",
      "description": "\uba54\ubaa8"
    },
    "is_completed": {
      "type": "boolean",
      "default": false,
      "description": "\uc218\uc5c5 \uc644\ub8cc \uc5ec\ubd80"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false,
      "description": "\uc0ad\uc81c \uc5ec\ubd80 (soft delete)"
    },
    "deleted_at": {
      "type": "string",
      "description": "\uc0ad\uc81c \uc2dc\uac01"
    },
    "google_event_id": {
      "type": "string",
      "description": "Google Calendar \uc774\ubca4\ud2b8 ID (\uc911\ubcf5 \ubc29\uc9c0\uc6a9 \uace0\uc720 \ud0a4)"
    },
    "calendar_source": {
      "type": "string",

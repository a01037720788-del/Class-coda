{
  "name": "StudentGoal",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "\ud559\uc0dd ID"
    },
    "student_name": {
      "type": "string",
      "description": "\ud559\uc0dd \uc774\ub984"
    },
    "goal_type": {
      "type": "string",
      "enum": [
        "problem_count",
        "bronze_rank",
        "unit_complete",
        "custom"
      ],
      "description": "\ubaa9\ud45c \uc720\ud615"
    },
    "title": {
      "type": "string",
      "description": "\ubaa9\ud45c \uc81c\ubaa9"
    },
    "target_value": {
      "type": "number",
      "description": "\ubaa9\ud45c \uc218\uce58"
